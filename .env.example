# Optional: GPT-generated title, description, and tags
OPENAI_API_KEY=

# Max input clip length in seconds (default 120, maximum 120)
# SHORTSAI_MAX_DURATION_SEC=120

# AI hook cold open length in seconds (3–8, default 5) when enabled in Step 2 or --ai-hook
# SHORTSAI_AI_HOOK_SEC=5

# AI narration (Step 2 / --ai-narration): OpenAI TTS voice, loudness, and duck level
# SHORTSAI_NARRATION_VOICE=alloy
# SHORTSAI_NARRATION_VOL=1.45
# SHORTSAI_NARRATION_ORIG_VOL=0.14
# SHORTSAI_NARRATION_SEGMENTS=4

# Whisper model: tiny, base, small, medium, large-v3 (larger = slower, more accurate)
SHORTSAI_WHISPER_MODEL=base

# Subtitles/transcript language: transcribe (default, same language as speech) or translate (English text for any speech)
# SHORTSAI_WHISPER_TASK=translate
# Optional hint when auto-detect is wrong (ISO 639-1): zh, ja, ko, en, ...
# SHORTSAI_WHISPER_LANGUAGE=zh

# How non-9:16 video is fitted into 1080×1920: crop (default) | letterbox | blur_fill
# SHORTSAI_VERTICAL_FIT=blur_fill

# Default vertical band for red timed scene text (not speech captions): upper | middle | lower
# SHORTSAI_OVERLAY_POSITION=lower

# Burned-in speech caption size (1–20, default 10) and red scene text size (36–100, default 64)
# SHORTSAI_CAPTION_FONT_SIZE=10
# SHORTSAI_SCENE_OVERLAY_FONT_SIZE=64

# Optional GPU: device cpu|cuda, compute int8|float16|float32
# SHORTSAI_WHISPER_DEVICE=cuda
# SHORTSAI_WHISPER_COMPUTE=float16

# FFmpeg (if Streamlit cannot find ffmpeg/ffprobe on PATH — common right after winget install until you restart the terminal/IDE)
# SHORTSAI_FFMPEG_DIR=C:\ffmpeg\bin
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
