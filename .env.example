# Optional: GPT-generated title, description, and tags
OPENAI_API_KEY=

# Whisper model: tiny, base, small, medium, large-v3 (larger = slower, more accurate)
SHORTSAI_WHISPER_MODEL=base

# Subtitles/transcript language: transcribe (default, same language as speech) or translate (English text for any speech)
# SHORTSAI_WHISPER_TASK=translate
# Optional hint when auto-detect is wrong (ISO 639-1): zh, ja, ko, en, ...
# SHORTSAI_WHISPER_LANGUAGE=zh

# Optional GPU: device cpu|cuda, compute int8|float16|float32
# SHORTSAI_WHISPER_DEVICE=cuda
# SHORTSAI_WHISPER_COMPUTE=float16

# FFmpeg (if Streamlit cannot find ffmpeg/ffprobe on PATH — common right after winget install until you restart the terminal/IDE)
# SHORTSAI_FFMPEG_DIR=C:\ffmpeg\bin
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
